# ───────────────────────────────────────────────────────────────────────────
# Next.js: copy to .env.local (gitignored).
# `npx convex dev` and `npx clerk init` fill most of these in automatically.
# ───────────────────────────────────────────────────────────────────────────

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (Dashboard → Configure → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Convex deployment env: NOT read from this file. Set each one with
#   npx convex env set NAME value
# ───────────────────────────────────────────────────────────────────────────
# CLERK_JWT_ISSUER_DOMAIN=    Clerk Frontend API URL, e.g. https://xxxx.clerk.accounts.dev
# N8N_NOTIFY_WEBHOOK_URL=     n8n request-notification webhook (tunnel URL)
# LENDLOOP_OUTBOUND_SECRET=   same value as in n8n/.env
# LENDLOOP_INBOUND_SECRET=    same value as in n8n/.env
#
# n8n secrets live in n8n/.env; see n8n/.env.example.
