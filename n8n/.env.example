# Copy to n8n/.env (gitignored) and fill in. Read by n8n/docker-compose.yml.
# Generate random secrets with:  openssl rand -hex 32

# n8n's Postgres password (internal to the compose network)
DB_POSTGRESDB_PASSWORD=

# Encrypts credentials stored in n8n. Keep it stable; changing it breaks saved credentials.
N8N_ENCRYPTION_KEY=

# Public URL of n8n webhooks, i.e. your tunnel (cloudflared/ngrok). Convex cloud cannot reach localhost.
# Example: https://random-words.trycloudflare.com/
N8N_WEBHOOK_URL=

# Convex HTTP actions base URL (note: .convex.site, not .convex.cloud)
# Example: https://your-deployment.convex.site
CONVEX_SITE_URL=

# HMAC secrets. Must match the values set in Convex with `npx convex env set`.
# OUTBOUND = Convex signs -> n8n verifies.  INBOUND = n8n signs -> Convex verifies.
# Use two different values so a leak in one direction doesn't compromise the other.
LENDLOOP_OUTBOUND_SECRET=
LENDLOOP_INBOUND_SECRET=

# Optional (not secrets). Defaults shown.
# LENDLOOP_APP_URL=http://localhost:3000        # links in emails
# LENDLOOP_ALERT_EMAIL=admin@lendloop.local     # error-workflow alerts (Mailpit catches all)
