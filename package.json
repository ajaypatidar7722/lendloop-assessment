{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f n8n/docker-compose.yml up -d",
    "infra:down": "docker compose -f n8n/docker-compose.yml down",
    "infra:logs": "docker compose -f n8n/docker-compose.yml logs -f n8n"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.51.0",
    "convex-helpers": "^0.1.136",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
